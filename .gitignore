# Jekyll 本地构建产物
_site/
.jekyll-cache/
.jekyll-metadata
Gemfile.lock

# 本地预览用：这两个文件只服务于本机跑 Jekyll，不进仓库
# （线上由 GitHub Pages 构建，构建配置只认 _config.yml）
Gemfile
_config.local.yml

# 编辑器 / 系统
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python 运行产物（.pyc 里会写入本机绝对路径，不要提交）
__pycache__/
*.py[cod]
.venv/
venv/

# 本地凭证与环境变量，一律不进仓库
.env
.env.*
*.local

# 巡检脚本运行时写出的临时报告
price-report.txt
link-report.txt
link-summary.txt

# 内部文档只留本地，不进仓库，也不随站点发布
# （docs/ 已在 _config.yml 的 exclude 里，这里再挡一道误提交）
docs/maintenance-guide.md
docs/architecture-plan.md
